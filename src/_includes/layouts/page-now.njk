---
layout: layouts/base-2026.njk
eleventyImport:
  collections: ["now"]
---

{% import "partials/components.njk" as ui %}
{% set updates = collections.now | newest %}

<div class="wrap" data-pagefind-meta="type:now">
    {{ ui.hero('/now', 'This is an archived update from <time datetime="' + (page.date | dateToFormat('ymd')) + '">' + (page.date | dateToFormat('long')) + '</time>. <a href="/now/">See what I am doing now →</a>', '<a href="/now/">Now</a>') }}
    <div class="page-layout page-layout--aside">
        <div class="prose">{{ content | safe }}</div>

        <aside>
            {{ ui.boxOpen('previously') }}
            <ul class="box__list">
                {% for update in updates %}
                    {% if not loop.first %}<li><a href="{{ update.url }}">{{ update.date | dateToFormat('monthYear') }}</a></li>{% endif %}
                {% endfor %}
            </ul>
            {{ ui.boxClose() }}
        </aside>
    </div>
</div>
