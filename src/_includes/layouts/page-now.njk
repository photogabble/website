{% extends "layouts/base-2026.njk" %}

{% set page_class = 'page__note' %}

{% if isNow %}
    {% set subTitle %}
        last updated {{ page.date | dateToFormat("dd LLL yyyy") }}.
    {% endset %}
{% else %}
    {% set subTitle %}
        this is an older now page.
    {% endset %}
{% endif %}

{% block content %}
    <article data-pagefind-meta="type:now">
        <header>
            <span>Info</span>
            <h1 class="title">{{ title }}</h1>
            <div class="abstract">
                <p>
                    This “now page” offers a big picture glimpse into my what I’m focused on at this point in my life.
                    <a href="https://nownownow.com/about">What is a now page?</a>
                </p>
            </div>
            <div class="seperator">
                <span>{{ collections.nowUpdates.length }} entries, {{ subTitle }}</span>
                <hr class="bar">
            </div>
        </header>

        {% include "components/side-bars/now.njk" %}

        <div class="content">
            {{ content | safe }}
        </div>
    </article>
{% endblock %}
