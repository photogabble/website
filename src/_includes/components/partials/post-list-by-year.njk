{% for year, items in itemsByYear %}
    <section class="post-list">
        <header class="post-list__inline-header">
            <h3>{{ year }}</h3>
            {% if showMonthLinks %}
            {% set postsByMonth = items | groupByMonth %}
            {% set year = year %}
            <nav>{% include 'components/months-of-year.njk' %}</nav>
            {% else %}
            <small>{{ items.length }} items</small>
            {% endif %}
        </header>
        <ol class="post-list__chronological">
            {% for post in items %}
                {% set displayContentType = true %}
                <li>
                    <div class="post-list__title">
                        <a href="{{ post.url }}" title="Read {{ post.data.title }}">
                            {{ post.data.title }}
                        </a>
                        <time datetime="{{ post.date | dateToFormat("yyyy-LL-dd") }}">{{ post.date | dateToFormat("MMM d") }}</time>
                    </div>
                    <div class="post-list__excerpt">
                        <p>{{ post.data.abstract }}</p>
                    </div>
                    <div>
                        {% if post.data.rating %}
                        {{ post.data.rating | ratingToStars }}
                        {% endif %}
                    </div>
                </li>
{#                {% include "components/post-list-line.njk" %}#}
            {% endfor %}
        </ol>
    </section>
{% endfor %}
