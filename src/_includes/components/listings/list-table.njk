{#
    # Item listing in table format
    Used to display a list of topic items, such as posts or articles, with their titles, dates, and other metadata.

    Variables:
    - `items`: Array of topic items to be listed.

    Used by:
    - src/changelog.md
    - src/series.md
#}
<section class="post-list">
    <ol class="post-list__chronological">
        {% for post in items %}
            <li>
                <div class="post-list__title">
                    <a href="{{ post.url }}" title="Read {{ post.data.title }}">
                        {{ post.data.title }}
                    </a>
                    <time datetime="{{ post.date | dateToFormat("yyyy-LL-dd") }}">{{ post.date | dateToFormat("DDD") }}</time>
                </div>
                <div class="post-list__excerpt">
                    <p>{{ post.data.abstract }}</p>
                </div>
                <div>
                    {% if post.data.rating %}
                        {{ post.data.rating | ratingToStars }}
                    {% endif %}
                </div>
            </li>
{#            {% include "components/post-list-line.njk" %}#}
        {% endfor %}
    </ol>
</section>
